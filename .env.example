# Copy to .env.local and restart with: npx expo start -c
#
# Your backend's base URL (no trailing slash). Leave empty for demo data.
# Physical phone: use your computer's LAN IP, not localhost.
# Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=

# Set to true to force demo data even when a URL is set.
EXPO_PUBLIC_USE_MOCK=
